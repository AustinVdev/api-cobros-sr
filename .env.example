# =====================================================================
# Variables de entorno - API de Cobros Automáticos Simulados
# Copia este archivo a ".env" y ajusta los valores según tu entorno.
#   cp .env.example .env
# =====================================================================

# Conexión a MySQL (coincide con las credenciales del docker-compose.yml)
DATABASE_URL="mysql://cobros_user:cobros_pass@localhost:3306/cobros_db"

# Token estático para autenticar las peticiones.
# Se envía en el header: Authorization: Bearer <API_TOKEN>
API_TOKEN="cambia-este-token-por-uno-seguro"

# Puerto en el que escucha la API
PORT=3000

# Nivel de log de pino: fatal | error | warn | info | debug | trace
LOG_LEVEL="info"

# Entorno: development | production | test
NODE_ENV="development"
